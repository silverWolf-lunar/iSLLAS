{
  "name": "@sllas/worker",
  "version": "0.1.0",
  "private": true,
  "description": "SLLAS background worker for notifications, outbox processing, and lease expiry checks",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sllas/contracts": "workspace:*",
    "dotenv": "^16.4.5",
    "nodemailer": "^10.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0"
  }
}

{
  "expo": {
    "name": "SLLAS Mobile",
    "slug": "sllas-mobile",
    "version": "1.0.0",
    "scheme": "sllas-mobile",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "zw.gov.sllas.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#030712"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "bundler": "metro"
    }
  }
}

{
  "name": "@sllas/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "SLLAS Mobile App (Expo / React Native)",
  "packageManager": "pnpm@9.12.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "dev": "expo start --clear",
    "build": "expo export -p all",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "prebuild": "expo prebuild --platform android",
    "build:apk": "npx -y eas-cli build -p android --profile preview",
    "build:apk:local": "cd android && gradlew.bat assembleRelease",
    "build:aab": "npx -y eas-cli build -p android --profile production"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.16",
    "@sllas/contracts": "workspace:*",
    "expo": "~58.0.22",
    "expo-auth-session": "~58.0.16",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.23",
    "eas-cli": "^27.2.0",
    "typescript": "^6.0.3"
  }
}

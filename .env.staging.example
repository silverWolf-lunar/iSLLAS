# Set DOMAIN to a DNS name pointing at the staging VM before starting Compose.
DOMAIN=pilot.example.gov.zw

# Keycloak realm issuer, e.g. https://identity.example.gov.zw/realms/sllas
OIDC_ISSUER=https://identity.example.gov.zw/realms/sllas
OIDC_AUDIENCE=sllas-api
KEYCLOAK_CLIENT_ID=sllas-web
KEYCLOAK_CLIENT_SECRET=REPLACE_WITH_KEYCLOAK_CLIENT_SECRET
NEXTAUTH_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_VALUE

POSTGRES_USER=sllas
POSTGRES_PASSWORD=REPLACE_WITH_A_UNIQUE_RANDOM_VALUE
POSTGRES_DB=sllas

# Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
WORKER_API_TOKEN=REPLACE_WITH_A_UNIQUE_RANDOM_VALUE

# Configure an SMTP provider with STARTTLS (port 587), or implicit TLS (port 465).
SMTP_HOST=smtp.example.gov.zw
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.gov.zw
SMTP_SECURE=false

WORKER_POLL_INTERVAL_MS=60000

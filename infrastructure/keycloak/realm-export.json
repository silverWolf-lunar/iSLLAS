{
    "realm":  "sllas",
    "enabled":  true,
    "displayName":  "SLLAS - Smart Land Lease and Allocation System",
    "registrationAllowed":  true,
    "loginWithEmailAllowed":  true,
    "duplicateEmailsAllowed":  false,
    "resetPasswordAllowed":  true,
    "editUsernameAllowed":  false,
    "bruteForceProtected":  true,
    "permanentLockout":  false,
    "maxFailureWaitSeconds":  900,
    "minimumQuickLoginWaitSeconds":  60,
    "waitIncrementSeconds":  60,
    "quickLoginCheckMilliSeconds":  1000,
    "maxDeltaTimeSeconds":  43200,
    "failureFactor":  5,
    "sslRequired":  "external",
    "defaultSignatureAlgorithm":  "RS256",
    "accessTokenLifespan":  300,
    "accessTokenLifespanForImplicitFlow":  900,
    "ssoSessionIdleTimeout":  1800,
    "ssoSessionMaxLifespan":  36000,
    "offlineSessionIdleTimeout":  2592000,
    "offlineSessionMaxLifespan":  5184000,
    "accessCodeLifespan":  60,
    "accessCodeLifespanLogin":  1800,
    "accessCodeLifespanUserAction":  300,
    "actionTokenGeneratedByAdminLifespan":  43200,
    "actionTokenGeneratedByUserLifespan":  300,
    "roles":  {
                  "realm":  [
                                {
                                    "name":  "sllas_system_admin",
                                    "description":  "System Administrator - full access"
                                },
                                {
                                    "name":  "sllas_registry_officer",
                                    "description":  "Registry Officer - land registration and application review"
                                },
                                {
                                    "name":  "sllas_approver",
                                    "description":  "Approver - application approval and lease management"
                                },
                                {
                                    "name":  "sllas_estates_officer",
                                    "description":  "Estates Officer - master waiting list and lease management"
                                },
                                {
                                    "name":  "sllas_auditor",
                                    "description":  "Auditor - read-only access to all records"
                                },
                                {
                                    "name":  "sllas_client",
                                    "description":  "Client - individual or business applying for land leases"
                                }
                            ]
              },
    "clients":  [
                    {
                        "clientId":  "sllas-api",
                        "name":  "SLLAS API",
                        "enabled":  true,
                        "clientAuthenticatorType":  "client-secret",
                        "secret":  "REPLACE_IN_KEYCLOAK_ADMINISTRATION",
                        "bearerOnly":  true,
                        "standardFlowEnabled":  false,
                        "directAccessGrantsEnabled":  true,
                        "serviceAccountsEnabled":  true,
                        "publicClient":  false,
                        "protocol":  "openid-connect"
                    },
                    {
                        "clientId":  "sllas-web",
                        "name":  "SLLAS Web Application",
                        "enabled":  true,
                        "clientAuthenticatorType":  "client-secret",
                        "secret":  "REPLACE_IN_KEYCLOAK_ADMINISTRATION",
                        "standardFlowEnabled":  true,
                        "directAccessGrantsEnabled":  false,
                        "serviceAccountsEnabled":  false,
                        "publicClient":  false,
                        "protocol":  "openid-connect",
                        "defaultClientScopes":  [
                                                    "openid",
                                                    "profile",
                                                    "email",
                                                    "roles"
                                                ]
                    },
                    {
                        "clientId":  "sllas-mobile",
                        "name":  "SLLAS Mobile Application",
                        "enabled":  true,
                        "standardFlowEnabled":  true,
                        "directAccessGrantsEnabled":  false,
                        "serviceAccountsEnabled":  false,
                        "publicClient":  true,
                        "protocol":  "openid-connect",
                        "attributes":  {
                                           "pkce.code.challenge.method":  "S256"
                                       },
                        "defaultClientScopes":  [
                                                    "openid",
                                                    "profile",
                                                    "email",
                                                    "roles"
                                                ]
                    }
                ]
}

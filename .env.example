# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=sllas
DB_PASSWORD=sllas_dev_password
DB_DATABASE=sllas
DB_SSL=false
DB_SYNCHRONIZE=false

# PostgreSQL bootstrap
POSTGRES_USER=sllas
POSTGRES_PASSWORD=sllas_dev_password
POSTGRES_DB=sllas

# Redis / RabbitMQ
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Worker
WORKER_POLL_INTERVAL_MS=60000
OUTBOX_API_URL=http://localhost:3001
WORKER_API_TOKEN=replace-with-a-random-secret-at-least-32-bytes

# SMTP / Mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@sllas.local
NOTIFY_TEST_EMAIL=ops@sllas.local

# Auth / app runtime
NODE_ENV=development
OIDC_ISSUER=http://localhost:8082/realms/sllas
OIDC_AUDIENCE=sllas-web
KEYCLOAK_CLIENT_ID=sllas-web
KEYCLOAK_CLIENT_SECRET=replace-with-keycloak-client-secret
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
